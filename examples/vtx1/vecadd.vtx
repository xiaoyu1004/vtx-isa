; vecadd: c[i] = a[i] + b[i]
; Recommended launch: N=16*1024*1024, NTID=(256,1,1), NCTA=(4096,1,1).
; Eight warps execute a grid-stride loop in each CTA.
;
; Parameter ABI:
;   s0:s1 = a      GLOBAL_PTR, byte offset 0
;   s2:s3 = b      GLOBAL_PTR, byte offset 8
;   s4:s5 = c      GLOBAL_PTR, byte offset 16
;   s6     = n      U32,        byte offset 24
;
; Descriptor resources: sgpr_count=16, vgpr_count=13, vp_count=2,
; reconv_stack_depth=1, static_shared_size=0.
;
; Register map:
;   v0=lane, v1=warp, v2=cta, v3=ntid, v4=ncta
;   v5=warp_base, v6=grid_stride, v8=i, v9=byte_offset
;   v10=a[i], v11=b[i], v12=c[i]
;
; `n` stays in s6. Every vector compare reads it directly through the V2/VCMP
; scalar-source selector, so no VGPR copy of a uniform value is needed.

vecadd:
    V_GETREG.LANE.U32 v0, LSR_LANE_ID
    V_GETREG.UNIFORM.U32 v1, USR_WARP_ID
    V_GETREG.UNIFORM.U32 v2, USR_CTA_ID_X
    V_GETREG.UNIFORM.U32 v3, USR_NTID_X
    V_GETREG.UNIFORM.U32 v4, USR_NCTA_X

    ; warp_base = cta_id * ntid_x + warp_id * 32
    V_MUL.U32 v5, v2, v3
    V_MUL.U32 v8, v1, 32
    V_ADD.U32 v5, v5, v8
    V_MUL.U32 v6, v3, v4

    ; v5 is uniform within a warp. Consequently the loop branch never
    ; divides a warp; vp1 only masks a possible final partial warp.
    SSY vecadd_done
vecadd_loop:
    V_CMP.LT.U32 vp0, v5, s6
    BRA.P !vp0, vecadd_done

    V_ADD.U32 v8, v5, v0
    V_CMP.LT.U32 vp1, v8, s6
    V_SHL.B32 v9, v8, 2
    @vp1 V_LD.GLOBAL.U32 v10, [s0:s1 + v9 + 0]
    @vp1 V_LD.GLOBAL.U32 v11, [s2:s3 + v9 + 0]
    @vp1 V_FADD.F32 v12, v10, v11
    @vp1 V_ST.GLOBAL.U32 [s4:s5 + v9 + 0], v12

    V_ADD.U32 v5, v5, v6
    BRA vecadd_loop

vecadd_done:
    JOIN
    EXIT PT
