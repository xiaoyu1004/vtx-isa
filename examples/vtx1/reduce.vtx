; Block reduction: one FP32 partial sum per CTA.
; Recommended launch: N=16*1024*1024, NTID=(256,1,1), NCTA=(4096,1,1).
; Run another reduction pass over the 4096 partials to obtain one value.
;
; Parameter ABI:
;   s0:s1 = input     GLOBAL_PTR, byte offset 0
;   s2:s3 = partials  GLOBAL_PTR, byte offset 8
;   s4     = n         U32,        byte offset 16
;
; Descriptor resources: sgpr_count=16, vgpr_count=16, vp_count=3,
; reconv_stack_depth=1, static_shared_size=32.
;
; Register map:
;   v0=lane, v1=warp, v2=cta, v3=ntid, v4=ncta
;   v6=warp_base, v7=grid_stride, v8=i, v9=byte_offset
;   v10=value, v11=sum, v12=shuffle value, v13=zero/warp count
;   v14=shared offset, v15=output offset
;
; `n` stays in s4 and the VCMP scalar-source selector reads it in place.

reduce:
    V_GETREG.LANE.U32 v0, LSR_LANE_ID
    V_GETREG.UNIFORM.U32 v1, USR_WARP_ID
    V_GETREG.UNIFORM.U32 v2, USR_CTA_ID_X
    V_GETREG.UNIFORM.U32 v3, USR_NTID_X
    V_GETREG.UNIFORM.U32 v4, USR_NCTA_X

    ; warp_base = cta_id * ntid_x + warp_id * 32
    V_MUL.U32 v6, v2, v3
    V_MUL.U32 v8, v1, 32
    V_ADD.U32 v6, v6, v8
    V_MUL.U32 v7, v3, v4
    V_MOV.B32 v11, 0x00000000

    ; The loop condition uses a warp-uniform base. Tail lanes are zero-filled.
    SSY reduce_loop_done
reduce_grid_loop:
    V_CMP.LT.U32 vp0, v6, s4
    BRA.P !vp0, reduce_loop_done

    V_ADD.U32 v8, v6, v0
    V_CMP.LT.U32 vp1, v8, s4
    V_SHL.B32 v9, v8, 2
    V_MOV.B32 v10, 0x00000000
    @vp1 V_LD.GLOBAL.U32 v10, [s0:s1 + v9 + 0]
    V_FADD.F32 v11, v11, v10

    V_ADD.U32 v6, v6, v7
    BRA reduce_grid_loop

reduce_loop_done:
    JOIN

    ; All 32 lanes remain active. The immediate-delta form avoids five
    ; separate delta materialization instructions in each reduction tree.
    V_SHUFFLE.DOWN.B32 v12, v11, 16, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 8, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 4, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 2, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 1, 32
    V_FADD.F32 v11, v11, v12

    ; lane 0 of each of the 8 warps publishes one partial.
    V_MOV.B32 v13, 0
    V_CMP.EQ vp0, v0, v13
    V_SHL.B32 v14, v1, 2
    @vp0 V_ST.SHARED.U32 [v14 + 0], v11
    BAR.SYNC.CTA 0

    ; Every warp performs the same second-stage reduction. Only warp 0,
    ; lane 0 commits the result, keeping the shuffle participation complete.
    V_MOV.B32 v11, 0x00000000
    V_MOV.B32 v13, 8
    V_CMP.LT.U32 vp1, v0, v13
    V_SHL.B32 v14, v0, 2
    @vp1 V_LD.SHARED.U32 v11, [v14 + 0]

    V_SHUFFLE.DOWN.B32 v12, v11, 16, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 8, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 4, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 2, 32
    V_FADD.F32 v11, v11, v12
    V_SHUFFLE.DOWN.B32 v12, v11, 1, 32
    V_FADD.F32 v11, v11, v12

    V_MOV.B32 v13, 0
    V_CMP.EQ vp0, v0, v13
    V_CMP.EQ vp1, v1, v13
    V_PAND vp2, vp0, vp1
    V_SHL.B32 v15, v2, 2
    @vp2 V_ST.GLOBAL.U32 [s2:s3 + v15 + 0], v11
    EXIT PT
